{
	"name": "@eshanika/database",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./db": "./src/prisma/db.ts",
		"./enums": "./src/generated/prisma/enums.ts"
	},
	"scripts": {
		"build": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"check-types": "prisma generate && tsc --noEmit",
		"lint": "biome check"
	},
	"dependencies": {
		"@eshanika/env": "workspace:*",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"dotenv": "18.0.4"
	},
	"devDependencies": {
		"@types/node": "26.6.2",
		"prisma": "7.10.0",
		"typescript": "7.0.2"
	}
}
