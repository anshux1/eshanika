model Payment {
  id                  String         @id @default(uuid()) @db.Uuid
  paymentOrderId      String         @db.Uuid
  provider            String         @default("razorpay")
  providerPaymentId   String
  status              String
  amountMinor         BigInt
  currencyCode        String
  paymentMethod       String?
  amountRefundedMinor BigInt         @default(0)
  refundStatus        String?
  feeMinor            BigInt?
  taxMinor            BigInt?
  errorCode           String?
  errorDescription    String?
  errorReason         String?
  errorSource         String?
  errorStep           String?
  capturedAt          DateTime?      @db.Timestamptz(6)
  providerCreatedAt   DateTime?      @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)
  paymentOrder        PaymentOrder   @relation(fields: [paymentOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentEvents       PaymentEvent[]
  refunds             Refund[]

  @@unique([provider, providerPaymentId])
  @@index([paymentOrderId], map: "Payment_paymentOrderId_idx_8a364cd5")
}

model PaymentEvent {
  id                 String                       @id @default(uuid()) @db.Uuid
  provider           String                       @default("razorpay")
  providerEventId    String
  eventType          String
  paymentOrderId     String?                      @db.Uuid
  paymentId          String?                      @db.Uuid
  providerOrderId    String?
  providerPaymentId  String?
  payload            Json                         @db.JsonB
  processingStatus   PaymentEventProcessingStatus @default(pending)
  processingError    String?
  attemptCount       Int                          @default(0)
  providerOccurredAt DateTime?                    @db.Timestamptz(6)
  receivedAt         DateTime                     @default(now()) @db.Timestamptz(6)
  processedAt        DateTime?                    @db.Timestamptz(6)
  nextAttemptAt      DateTime                     @default(now()) @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  paymentOrder       PaymentOrder?                @relation(fields: [paymentOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment            Payment?                     @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, providerEventId])
  @@index([paymentId], map: "PaymentEvent_paymentId_idx_b2fe9a10")
  @@index([paymentOrderId], map: "PaymentEvent_paymentOrderId_idx_8a364cd5")
}

model Refund {
  id                String                @id @default(uuid()) @db.Uuid
