generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserAddress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String
  label         String?
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  landmark      String?
  city          String
  state         String
  postalCode    String
  countryCode   String   @default("IN")
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "UserAddress_userId_idx_a489d58a")
}

model AdminAuditLog {
  id             String            @id @default(uuid()) @db.Uuid
  actorUserId    String?
  actorAdminRole AdminRole?
  action         String
  entityType     String
  entityId       String
  outcome        AdminAuditOutcome @default(success)
  reason         String?
  beforeData     Json?             @db.JsonB
  afterData      Json?             @db.JsonB
  metadata       Json?             @db.JsonB
  requestId      String?
  sessionId      String?
  ipAddress      String?           @db.Inet
  userAgent      String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
}

model AdminInvitation {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String    @unique
  phoneNumber      String
  role             AdminRole
  invitedByUserId  String
  acceptedByUserId String?
  expiresAt        DateTime  @db.Timestamptz(6)
  acceptedAt       DateTime? @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
}

model AdminMembership {
  userId    String                @id
  role      AdminRole             @default(editor)
  status    AdminMembershipStatus @default(active)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @db.Timestamptz(6)
  user      User                  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Attribute {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String                   @unique
  displayType             AttributeDisplayType     @default(select)
  sortOrder               Int                      @default(0)
  status                  AttributeStatus          @default(active)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  attributeOptions        AttributeOption[]
  productAttributes       ProductAttribute[]
  productAttributeOptions ProductAttributeOption[]
}

model AttributeOption {
  id                      String                   @id @default(uuid()) @db.Uuid
  attributeId             String                   @db.Uuid
  name                    String
  slug                    String
  swatchValue             String?
  sortOrder               Int                      @default(0)
  status                  AttributeStatus          @default(active)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  attribute               Attribute                @relation(fields: [attributeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productAttributeOptions ProductAttributeOption[]
  variantAttributeOptions VariantAttributeOption[]

  @@unique([attributeId, slug])
  @@index([attributeId], map: "AttributeOption_attributeId_idx_58ec5fae")
}

model AuthRateBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(6)
}

model AuthEvent {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  requestId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model User {
  id                   String               @id
  name                 String
  email                String               @unique
  emailVerified        Boolean              @default(false)
  image                String?
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)
  phoneNumber          String?              @unique
  phoneNumberVerified  Boolean?
  role                 UserRole             @default(customer)
  userAddresses        UserAddress[]
  adminMembership      AdminMembership?
  sessions             Session[]
  accounts             Account[]
  carts                Cart[]
  couponRedemptions    CouponRedemption[]
  fulfillmentEvents    FulfillmentEvent[]
  inventoryMovements   InventoryMovement[]
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]
  orderNotes           OrderNote[]
  refunds              Refund[]
  returnRequests       ReturnRequest[]
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "Session_userId_idx_a489d58a")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@index([userId], map: "Account_userId_idx_a489d58a")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
}

model Cart {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String
  status           CartStatus @default(active)
  convertedOrderId String?    @unique @db.Uuid
  expiresAt        DateTime   @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)
  user             User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convertedOrder   Order?     @relation(fields: [convertedOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cartItems        CartItem[]

  @@index([userId], map: "Cart_userId_idx_a489d58a")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cartId, variantId])
  @@index([cartId], map: "CartItem_cartId_idx_79939295")
  @@index([variantId], map: "CartItem_variantId_idx_e16bb45d")
}

model CategoryProduct {
  categoryId String   @db.Uuid
  productId  String   @db.Uuid
  sortOrder  Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([categoryId, productId])
  @@index([categoryId], map: "CategoryProduct_categoryId_idx_15c304f2")
  @@index([productId], map: "CategoryProduct_productId_idx_5858600a")
}

model Category {
  id                  String               @id @default(uuid()) @db.Uuid
  parentId            String?              @db.Uuid
  name                String
  slug                String               @unique
  description         String?
  sortOrder           Int                  @default(0)
  status              CategoryStatus       @default(active)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  parent              Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryProducts    CategoryProduct[]
  navigationMenuItems NavigationMenuItem[]
  children            Category[]           @relation("CategoryTree")

  @@index([parentId], map: "Category_parentId_idx_6a68f597")
}

model ContentEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  title               String
  kind                ContentEntryKind     @default(page)
  placement           String?              @unique
  slug                String               @unique
  status              ContentEntryStatus   @default(draft)
  bodyHtml            String               @default("")
  publishedAt         DateTime?            @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  navigationMenuItems NavigationMenuItem[]
}

model NavigationMenu {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  location            String?              @unique
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  navigationMenuItems NavigationMenuItem[]
}

model NavigationMenuItem {
  id             String         @id @default(uuid()) @db.Uuid
  menuId         String         @db.Uuid
  categoryId     String?        @db.Uuid
  contentEntryId String?        @db.Uuid
  url            String?
  label          String
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  menu           NavigationMenu @relation(fields: [menuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contentEntry   ContentEntry?  @relation(fields: [contentEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([categoryId], map: "NavigationMenuItem_categoryId_idx_15c304f2")
  @@index([contentEntryId], map: "NavigationMenuItem_contentEntryId_idx_b2a3fabd")
  @@index([menuId], map: "NavigationMenuItem_menuId_idx_261f575e")
}

model Coupon {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  kind                  DiscountKind
  value                 Decimal                @db.Decimal(12, 2)
  minimumSubtotal       Decimal                @default(0) @db.Decimal(12, 2)
  maximumDiscount       Decimal?               @db.Decimal(12, 2)
  usageLimit            Int?
  perUserLimit          Int                    @default(1)
  startsAt              DateTime               @default(now()) @db.Timestamptz(6)
  expiresAt             DateTime?              @db.Timestamptz(6)
  archivedAt            DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  couponRedemptions     CouponRedemption[]
  couponShippingBenefit CouponShippingBenefit?
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  orderId        String   @unique @db.Uuid
  userId         String
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([couponId], map: "CouponRedemption_couponId_idx_a9dd19dc")
  @@index([userId], map: "CouponRedemption_userId_idx_a489d58a")
}

model CheckoutFeeRule {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  paymentMethod String   @default("cod")
  amount        Decimal  @db.Decimal(12, 2)
  currencyCode  String   @default("INR")
  taxable       Boolean  @default(false)
  optional      Boolean  @default(false)
  enabled       Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}

model OrderFee {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  name         String
  amount       Decimal  @db.Decimal(12, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(12, 2)
  currencyCode String   @default("INR")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "OrderFee_orderId_idx_d284871b")
}

model Fulfillment {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @db.Uuid
  status              FulfillmentStatus  @default(pending)
  carrier             String?
  trackingNumber      String?
  trackingUrl         String?
  estimatedDeliveryAt DateTime?          @db.Timestamptz(6)
  shippedAt           DateTime?          @db.Timestamptz(6)
  deliveredAt         DateTime?          @db.Timestamptz(6)
  failureReason       String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)
  order               Order              @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fulfillmentItems    FulfillmentItem[]
  fulfillmentEvents   FulfillmentEvent[]

  @@index([orderId], map: "Fulfillment_orderId_idx_d284871b")
}

model FulfillmentItem {
  orderId       String      @db.Uuid
  fulfillmentId String      @db.Uuid
  orderItemId   String      @db.Uuid
  quantity      Int
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([fulfillmentId, orderItemId])
  @@index([fulfillmentId], map: "FulfillmentItem_fulfillmentId_idx_b6c1e5d8")
  @@index([orderItemId], map: "FulfillmentItem_orderItemId_idx_99e2d9f7")
}

model FulfillmentEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  fulfillmentId   String                 @db.Uuid
  status          FulfillmentStatus
  source          FulfillmentEventSource @default(carrier)
  provider        String?
  providerStatus  String?
  description     String?
  location        String?
  externalEventId String?
  rawPayload      Json?                  @db.JsonB
  occurredAt      DateTime               @default(now()) @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  createdByUserId String?
  fulfillment     Fulfillment            @relation(fields: [fulfillmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser   User?                  @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdByUserId], map: "FulfillmentEvent_createdByUserId_idx_93e8a540")
  @@index([fulfillmentId], map: "FulfillmentEvent_fulfillmentId_idx_b6c1e5d8")
}

model InventoryLevel {
  id               String         @id @default(uuid()) @db.Uuid
  variantId        String         @unique @db.Uuid
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  reorderPoint     Int            @default(0)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model InventoryMovement {
  id             String                  @id @default(uuid()) @db.Uuid
  variantId      String                  @db.Uuid
  idempotencyKey String                  @unique
  quantityDelta  Int
  quantityAfter  Int
  reason         InventoryMovementReason
  referenceType  String?
  referenceId    String?
  note           String?
  actorUserId    String?
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  variant        ProductVariant          @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorUser      User?                   @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorUserId], map: "InventoryMovement_actorUserId_idx_96dac96c")
  @@index([variantId], map: "InventoryMovement_variantId_idx_e16bb45d")
}

model MediaAsset {
  id               String           @id @default(uuid()) @db.Uuid
  storageKey       String           @unique
  originalFileName String
  mimeType         String
  fileSizeBytes    BigInt
  width            Int?
  height           Int?
  altText          String?
  status           MediaAssetStatus @default(active)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  productMedia     ProductMedia[]
}

model ProductMedia {
  productId    String     @db.Uuid
  mediaAssetId String     @db.Uuid
  role         MediaRole  @default(gallery)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  product      Product    @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, mediaAssetId])
  @@index([mediaAssetId], map: "ProductMedia_mediaAssetId_idx_523c8890")
  @@index([productId], map: "ProductMedia_productId_idx_5858600a")
}

model Order {
  id                    String                 @id @default(uuid()) @db.Uuid
  orderNumber           String                 @unique
  userId                String
  status                OrderStatus            @default(created)
  paymentStatus         OrderPaymentStatus     @default(pending)
  fulfillmentStatus     OrderFulfillmentStatus @default(unfulfilled)
  currencyCode          String                 @default("INR")
  subtotalAmount        Decimal                @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal                @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal                @default(0) @db.Decimal(12, 2)
  shippingAmount        Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                @default(0) @db.Decimal(12, 2)
  billingEmail          String
  customerNote          String?
  placedAt              DateTime?              @db.Timestamptz(6)
  paidAt                DateTime?              @db.Timestamptz(6)
  completedAt           DateTime?              @db.Timestamptz(6)
  cancelledAt           DateTime?              @db.Timestamptz(6)
  cancelledReason       String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cart                  Cart?
  couponRedemption      CouponRedemption?
  orderFees             OrderFee[]
  fulfillments          Fulfillment[]
  orderItems            OrderItem[]
  orderAddresses        OrderAddress[]
  orderStatusHistories  OrderStatusHistory[]
  orderNotes            OrderNote[]
  paymentOrders         PaymentOrder[]
  inventoryReservations InventoryReservation[]
  returnRequests        ReturnRequest[]

  @@index([userId], map: "Order_userId_idx_a489d58a")
}

model OrderItem {
  id                     String                 @id @default(uuid()) @db.Uuid
  orderId                String                 @db.Uuid
  productId              String?                @db.Uuid
  variantId              String?                @db.Uuid
  productNameSnapshot    String
  variantNameSnapshot    String
  skuSnapshot            String
  variantOptionsSnapshot Json?                  @db.JsonB
  quantity               Int
  unitPrice              Decimal                @db.Decimal(12, 2)
  discountAmount         Decimal                @default(0) @db.Decimal(12, 2)
  taxAmount              Decimal                @default(0) @db.Decimal(12, 2)
  shippingAmount         Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal                @default(0) @db.Decimal(12, 2)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product                Product?               @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant                ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fulfillmentItems       FulfillmentItem[]
  inventoryReservations  InventoryReservation[]
  returnItems            ReturnItem[]

  @@index([orderId], map: "OrderItem_orderId_idx_d284871b")
  @@index([productId], map: "OrderItem_productId_idx_5858600a")
  @@index([variantId], map: "OrderItem_variantId_idx_e16bb45d")
}

model OrderAddress {
  id            String           @id @default(uuid()) @db.Uuid
  orderId       String           @db.Uuid
  addressType   OrderAddressType
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  landmark      String?
  city          String
  state         String
  postalCode    String
  countryCode   String           @default("IN")
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  order         Order            @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orderId, addressType])
  @@index([orderId], map: "OrderAddress_orderId_idx_d284871b")
}

model OrderStatusHistory {
  id              String                   @id @default(uuid()) @db.Uuid
  orderId         String                   @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  source          OrderStatusHistorySource @default(system)
  provider        String?
  changedByUserId String?
  note            String?
  metadata        Json?                    @db.JsonB
  externalEventId String?
  occurredAt      DateTime                 @default(now()) @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  order           Order                    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changedByUser   User?                    @relation(fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([changedByUserId], map: "OrderStatusHistory_changedByUserId_idx_a776e8b0")
  @@index([orderId], map: "OrderStatusHistory_orderId_idx_d284871b")
}

model OrderNote {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  authorUserId String?
  note         String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorUser   User?    @relation(fields: [authorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([authorUserId], map: "OrderNote_authorUserId_idx_d1814ea0")
  @@index([orderId], map: "OrderNote_orderId_idx_d284871b")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventType      String
  idempotencyKey String    @unique
  payload        Json      @db.JsonB
  attemptCount   Int       @default(0)
  availableAt    DateTime  @default(now()) @db.Timestamptz(6)
  leaseToken     String?   @db.Uuid
  leasedUntil    DateTime? @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
}

model PaymentOrder {
  id                      String                      @id @default(uuid()) @db.Uuid
  orderId                 String                      @db.Uuid
  provider                String                      @default("razorpay")
  idempotencyKey          String
  providerOrderId         String?
  receipt                 String
  amountMinor             BigInt
  currencyCode            String                      @default("INR")
  status                  PaymentOrderLifecycleStatus @default(pending)
  providerStatus          String?
  providerAmountPaidMinor BigInt?
  providerAmountDueMinor  BigInt?
  providerAttempts        Int                         @default(0)
  providerCreatedAt       DateTime?                   @db.Timestamptz(6)
  createdAt               DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                    @updatedAt @db.Timestamptz(6)
